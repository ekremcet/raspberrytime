[Unit]
Description=Sesli Mesaj Kutusu ilk kurulum
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/mesajkutusu/kuruldu

[Service]
Type=oneshot
ExecStart=/bin/bash /boot/firmware/mesajkutusu/sistem/ilk-kurulum.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
