# Sesli Mesaj Kutusu - başlangıç ayarları
# Bu dosyayı "ayarlar.env" adıyla kopyala ve doldur. Değiştirdikten sonra:
#   systemctl --user restart mesajkutusu
#
# Kutu kurulduktan sonra TÜM ayarlar (ses, ekran, dil, sessiz mod, PIN, bot anahtarı...)
# yönetim sayfasından değiştirilebilir: http://mesajkutusu.local:8080/yonetim
# Yönetim sayfasında değiştirilen bir ayar bu dosyadakinin önüne geçer.

# @BotFather'dan aldığın bot anahtarı. Boş bırakırsan DEMO modunda çalışır.
BOT_TOKEN=

# Yönetim sayfasının PIN'i (rakam). Boş bırakırsan ilk açılışta rastgele üretilir
# ve veri/yonetici_pin.txt dosyasına yazılır.
YONETICI_PIN=

# Kutunun adı (yönetim sayfasında da değiştirilebilir)
KUTU_ADI=Mesaj Kutusu

# Sunucu portu
PORT=8080
