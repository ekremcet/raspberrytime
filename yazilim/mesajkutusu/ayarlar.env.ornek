# Sesli Mesaj Kutusu ayarları
# Bu dosyayı "ayarlar.env" adıyla kopyala ve doldur. Değiştirdikten sonra:
#   systemctl --user restart mesajkutusu

# @BotFather'dan aldığın bot anahtarı. Boş bırakırsan DEMO modunda çalışır.
BOT_TOKEN=

# Yönetim sayfasının PIN'i (rakam). Boş bırakırsan ilk açılışta rastgele üretilir
# ve veri/yonetici_pin.txt dosyasına yazılır.
YONETICI_PIN=

# Aile üyelerine giden mesajlarda ve bot yanıtlarında geçen ad
KUTU_ADI=Mesaj Kutusu

# En uzun kayıt süresi (saniye)
MAKS_SANIYE=60

# Dinlenmemiş mesaj varken kaç dakikada bir hatırlatma zili çalsın (0: kapalı)
HATIRLAT_DAKIKA=10

# Ekran kararma süresi, sessiz mod ve gece saatleri artık yönetim sayfasından ayarlanır
# (eski UYKU_DAKIKA ve SESSIZ_SAATLER satırları varsa yok sayılır).

# Ekran yönü: boş bırakırsan sistemin kendi ayarı (Control Centre > Screens) kullanılır.
# 0, 90, 180 veya 270 yazarsan kutu her açılışta bu yönü uygular. Görüntü ters ise 180.
EKRAN_DONDUR=

PORT=8080

# 1 yaparsan çocuk ekranı ev ağındaki başka bir bilgisayardan da açılabilir (deneme için)
UZAKTAN_ARAYUZ=0
